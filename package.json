{
	"name": "fastify-boilerplate-api",
	"version": "1.0.3",
	"main": "index.js",
	"scripts": {
		"dev": "tsx --watch --env-file .env src/shared/infra/http/server.ts",
		"build": "tsup src/shared/infra/http/server.ts --format cjs --dts --out-dir dist --clean",
		"start": "node -r tsconfig-paths/register dist/server.js",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"biome:check": "biome check --write .",
		"prepare": "husky",
		"test": "vitest"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.12.3",
	"devDependencies": {
		"@biomejs/biome": "2.3.4",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@types/node": "^25.9.3",
		"@types/supertest": "^6.0.3",
		"husky": "^9.1.7",
		"supertest": "^7.1.4",
		"tsup": "^8.5.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vitest": "^4.0.7"
	},
	"dependencies": {
		"@fastify/cors": "^11.1.0",
		"@fastify/jwt": "^10.0.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/swagger": "^9.5.2",
		"@scalar/fastify-api-reference": "^1.39.2",
		"fastify": "^5.6.1",
		"fastify-type-provider-zod": "^6.1.0",
		"module-alias": "^2.2.3",
		"tsconfig-paths": "^4.2.0",
		"zod": "^4.1.12"
	}
}
